COURT_PROVIDER=parser_api
PARSER_API_KEY=
PARSER_API_BASE_URL=https://parser-api.com/parser/ras_arbitr_api
PARSER_API_TIMEOUT_SECONDS=25
PARSER_API_MAX_RETRIES=1

LLM_PROVIDER=gigachat
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b

GIGACHAT_AUTH_KEY=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_PLAN_MODEL=GigaChat-2
GIGACHAT_RELEVANCE_MODEL=GigaChat-2-Pro
# Optional path to a CA certificate bundle; TLS verification remains enabled.
GIGACHAT_CA_BUNDLE=
# Conservative evidence-search profile. Retries share the operation timeout.
SEARCH_TIMEOUT_SECONDS=120
RETRIEVAL_TIMEOUT_SECONDS=45
PLAN_TIMEOUT_SECONDS=45
RELEVANCE_TIMEOUT_SECONDS=35
# Серверный потолок для явно выбранного расширенного режима; обычный режим отправляет не более 3.
SEARCH_MAX_QUERIES=10
SEARCH_MAX_PAGES_PER_QUERY=1
# Обычный режим проверяет не более 2 PDF.
SEARCH_MAX_CASES=6
SEARCH_MAX_PDF_DOWNLOADS=6
